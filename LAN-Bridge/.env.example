# LAN-only TV Home settings. Copy to .env and keep that file private.
# 127.0.0.1 only allows this computer to connect.
# For your TV at 192.168.1.47, set HOST=192.168.1.42 (your PC's LAN IP).
# Restrict inbound TCP 8787 to the TV's IP with Windows Firewall.
HOST=127.0.0.1
PORT=8787

# Sonarr & Radarr are both installed on the user's 192.168.1.48 media host.
SONARR_URL=http://192.168.1.48:8989
RADARR_URL=http://192.168.1.48:7878

# Obtain from each service: Settings > General > Security > API Key.
# These stay in the Node server. Never put them in the browser's settings.
SONARR_API_KEY=
RADARR_API_KEY=

# Default news ticker RSS source (fetched by the LAN server).
NEWS_RSS_URL=https://news.google.com/rss?hl=en-US&gl=US&ceid=US:en
